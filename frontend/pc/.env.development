# ===== 前端开发服务器 =====
# Vite dev server 监听地址和端口
VITE_SERVER_HOST=localhost
VITE_SERVER_PORT=8004

# ===== 后端 API 代理 =====
# Django 后端完整 URL，所有 /api /openapi /init /core 请求代理到此地址
VITE_API_TARGET=http://localhost:8001

# ===== 页面全局变量（对应生产模式 index.html 中 Django 模板变量）=====
VITE_VERSION=dev
VITE_LOG_NAME=流程服务

# ===== 用户数据（开发模式模拟，生产模式由 Django 模板注入）=====
VITE_USERNAME=
VITE_CHNAME=
VITE_IS_ITSM_ADMIN=0

# ===== 平台配置（开发模式模拟，生产模式由 Django 模板注入）=====
VITE_PLATFORM_NAME=流程服务
VITE_BRAND_NAME=ITSM
VITE_FAVICON=/static/core/images/bk_itsm.png
VITE_APP_LOGO=/static/core/images/bk_itsm.png
