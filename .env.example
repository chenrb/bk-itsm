# =============================================================================
# BK-ITSM 环境配置
# 复制为 .env.development.local 后根据实际环境修改
# =============================================================================

# ---- 基础 ----
APP_CODE=bk_itsm
SECRET_KEY=changeme-in-production
DEBUG=true

# ---- MySQL ----
MYSQL_NAME=bk_itsm
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_TEST_NAME=bk_itsm_test

# ---- Redis（必选，缓存和数据后端依赖 Redis）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MODE=single
# 哨兵模式配置（REDIS_MODE=replication 时启用）
# REDIS_SERVICE_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=

# ---- Celery ----
BROKER_URL=redis://localhost:6379/0

# ---- 国际化 ----
# LANGUAGE_CODE=zh-hans

# ---- 管理员 ----
# ITSM_ADMIN=admin,user1,user2

# ---- 前端地址 ----
# FRONTEND_URL=http://localhost:8004

# ---- 平台 API（可选，对接外部平台时配置）----
# PLATFORM_API_BASE_URL=
# PLATFORM_API_URL=
# API_URL_TEMPLATE=
# USER_MANAGE_HOST=

# ---- 业务 ----
# SYSTEM_USE_API_ACCOUNT=admin
# AUTO_APPROVE_TIME=5
# AUTO_COMMENT_DAYS=3
# TICKET_INVITE_SMS_COUNT=10
# OPEN_VOICE_NOTICE=false
# CLOSE_NOTIFY=
# USER_WHITE_FIELDS=id,username,display_name,domain,logo,category_id,category_name

# ---- 通知 ----
# ENABLE_NOTIFY_ROUTER=false
# NOTIFY_ROUTER_NAME=router
# CLOSE_EVERY_DAY_TICKET_NOTIFY=false
# CONTENT_CREATOR_WITH_TRANSLATION=true

# ---- 监控 ----
# MONITOR_PROXY_IP=
# MONITOR_PROXY_PORT=10205
# AUTO_TIMEOUT_MINUTES=30
# STATSD_HOST=localhost
# STATSD_PORT=8125

# ---- Web ----
# CSRF_COOKIE_NAME=bkitsm_csrftoken
# LOGIN_URL=/account/login/
# CORS_ENABLED=true

# ---- 文档 ----
# DOC_CENTER_HOST=#

# ---- 企微 webhook ----
# QW_WEB_HOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key={}

# ---- 邮件 ----
# EMAIL_HOST=localhost
# EMAIL_PORT=25
# EMAIL_USE_TLS=false
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=itsm@localhost
