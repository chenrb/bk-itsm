# =============================================================================
# BK-ITSM 环境配置
# 复制为 .env 后根据实际环境修改
# =============================================================================

# ---- 基础 ----
APP_CODE=bk_itsm
APP_TOKEN=12345678-1234-5678-1234-123456789012
SECRET_KEY=changeme-in-production
DEBUG=true
RUN_MODE=DEVELOP

# ---- MySQL ----
BK_MYSQL_NAME=bk_itsm
BK_MYSQL_USER=root
BK_MYSQL_PASSWORD=root
BK_MYSQL_HOST=localhost
BK_MYSQL_PORT=3306
BK_MYSQL_TEST_NAME=bk_itsm_test

# ---- Redis（可选，不配置则使用 MySQL 作为缓存和数据后端）----
# BKAPP_REDIS_HOST=localhost
# BKAPP_REDIS_PORT=6379
# BKAPP_REDIS_PASSWORD=
# BKAPP_REDIS_DB=0
# BKAPP_REDIS_MODE=single
# 哨兵模式配置
# BKAPP_REDIS_MODE=replication
# BKAPP_REDIS_SERVICE_NAME=mymaster
# BKAPP_REDIS_SENTINEL_PASSWORD=

# ---- Celery ----
BROKER_URL=redis://localhost:6379/0
# BK_CELERYD_CONCURRENCY=2

# ---- 日志 ----
# LOG_LEVEL=DEBUG
# BKAPP_ENABLE_OTEL_TRACE=0

# ---- 国际化 ----
# BKAPP_BACKEND_LANGUAGE=zh-hans

# ---- 管理员 ----
# BKAPP_ITSM_ADMIN=admin,user1,user2

# ---- 平台地址（兼容垫片，后续清理）----
BK_PAAS_HOST=http://127.0.0.1
# BK_PAAS_INNER_HOST=http://127.0.0.1
# RUN_VER=open

# ---- IAM ----
USE_IAM=false
# BKAPP_BK_IAM_SYSTEM_ID=bk_itsm
# BKAPP_BK_IAM_SYSTEM_NAME=ITSM
# BK_IAM_V3_INNER_HOST=
# BK_IAM_V3_APP_CODE=bk_iam
# BKAPP_IAM_INITIAL_FILE=
# BKAPP_IAM_SDK_CLIENT_TIMEOUT=20

# ---- APIGW ----
# BKAPP_APIGW_APP_CODE=
# BKAPP_APIGW_SECRET_KEY=
# BKAPP_APIGW_USERNAME=
# BK_APIGW_NAME=bk-itsm
# APIGW_PUBLIC_KEY=

# ---- 业务 ----
# SYSTEM_USE_API_ACCOUNT=admin
# BKAPP_AUTO_APPROVE_TIME=5
# BKAPP_AUTO_COMMENT_DAYS=3
# BKAPP_TICKET_INVITE_SMS_COUNT=10
# BKAPP_OPEN_VOICE_NOTICE=false
# BKAPP_CUSTOM_TITLE=
# BKAPP_LOG_NAME=
# BKAPP_CLOSE_NOTIFY=

# ---- 通知 ----
# BKAPP_ENABLE_NOTIFY_ROUTER=false
# BKAPP_NOTIFY_ROUTER_NAME=router
# BKAPP_CLOSE_EVERY_DAY_TICKET_NOTIFY=false
# CONTENT_CREATOR_WITH_TRANSLATION=true

# ---- 监控 ----
# MONITOR_PROXY_IP=
# MONITOR_PROXY_PORT=10205
# AUTO_TIMEOUT_MINUTES=30
# STATSD_HOST=localhost
# STATSD_PORT=8125

# ---- Web ----
# BKAPP_ALLOW_CSRF=0
# BKPAAS_BK_DOMAIN=
# LOGIN_URL=/account/login/
